<?xml version="1.0"?>
<psalm
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://getpsalm.org/schema/config"
    errorLevel="4"
    findUnusedVariables="false"
    findUnusedCode="false"
    checkExternalDeclarations="false"
>
    <projectFiles>
        <directory name="src"/>
        <directory name="tests"/>
        <ignoreFiles>
            <directory name="vendor"/>
            <directory name="tests/sample_vulnerable_app"/>
        </ignoreFiles>
    </projectFiles>
</psalm>
